{
  "title": "AutoCenter - Analise de erros",
  "description": "Onde e por que os servicos falham: HTTP 4xx/5xx, Kafka, banco, chamadas externas, tarefas agendadas, logs e pods.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "service",
      "prefix": "service",
      "available_values": [],
      "default": "*"
    }
  ],
  "notify_list": [],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "Erros HTTP",
        "background_color": "vivid_red",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Respostas por classe de status",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.servlet.request.hits{$env,$service,http.status_code:2*}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "sum:trace.servlet.request.hits{$env,$service,http.status_code:4*}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q3",
                      "query": "sum:trace.servlet.request.hits{$env,$service,http.status_code:5*}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "alias": "2xx"
                    },
                    {
                      "formula": "q2",
                      "alias": "4xx"
                    },
                    {
                      "formula": "q3",
                      "alias": "5xx"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Erros 5xx por servico",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.servlet.request.errors{$env,$service} by {service}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Endpoints com mais erros 5xx",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.servlet.request.errors{$env,$service} by {service,resource_name}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      },
                      "conditional_formats": [
                        {
                          "comparator": ">=",
                          "value": 10,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": ">=",
                          "value": 1,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": "<",
                          "value": 1,
                          "palette": "white_on_green"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Codigos de status por servico",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.servlet.request.hits{$env,$service,!http.status_code:2*} by {service,http.status_code}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      }
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Endpoints mais lentos (p95, ms)",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "p95:trace.servlet.request{$env,$service} by {service,resource_name}",
                      "aggregator": "max"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 * 1000",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      },
                      "conditional_formats": [
                        {
                          "comparator": ">=",
                          "value": 1500,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": ">=",
                          "value": 500,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": "<",
                          "value": 500,
                          "palette": "white_on_green"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 6,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "% de requisicoes com 4xx por servico",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.servlet.request.hits{$env,$service,http.status_code:4*} by {service}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "sum:trace.servlet.request.hits{$env,$service} by {service}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * default_zero(q1) / q2",
                      "alias": "% 4xx"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 6,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 10,
        "is_column_break": false
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Erros em integracoes",
        "background_color": "vivid_purple",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Erros ao consumir do Kafka",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.kafka.consume.errors{$env,$service} by {service,resource_name}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Erros nas chamadas HTTP de saida",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.http.request.errors{$env,$service} by {service}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Erros no banco (MySQL e Mongo)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.mysql.query.errors{$env,$service} by {service}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "sum:trace.mongo.query.errors{$env,$service} by {service}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "alias": "MySQL"
                    },
                    {
                      "formula": "q2",
                      "alias": "Mongo"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Erros em tarefas agendadas (outbox, prazos)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.scheduled.call.errors{$env,$service} by {service,resource_name}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Latencia p95 das queries (ms)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "p95:trace.mysql.query{$env,$service} by {service}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "p95:trace.mongo.query{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 * 1000",
                      "alias": "MySQL"
                    },
                    {
                      "formula": "q2 * 1000",
                      "alias": "Mongo"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 10,
        "width": 12,
        "height": 7,
        "is_column_break": false
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Logs",
        "background_color": "vivid_pink",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Logs de erro por servico",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "q1",
                      "indexes": [
                        "*"
                      ],
                      "compute": {
                        "aggregation": "count"
                      },
                      "search": {
                        "query": "status:error $env $service"
                      },
                      "group_by": [
                        {
                          "facet": "service",
                          "limit": 10,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        }
                      ]
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Logs de alerta (warn) por servico",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "q1",
                      "indexes": [
                        "*"
                      ],
                      "compute": {
                        "aggregation": "count"
                      },
                      "search": {
                        "query": "status:warn $env $service"
                      },
                      "group_by": [
                        {
                          "facet": "service",
                          "limit": 10,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        }
                      ]
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "log_stream",
              "title": "Erros e alertas (clique para abrir o trace)",
              "title_size": "16",
              "title_align": "left",
              "indexes": [],
              "query": "status:(error OR warn) $env $service",
              "columns": [
                "service",
                "host"
              ],
              "sort": {
                "column": "time",
                "order": "desc"
              },
              "message_display": "expanded-md",
              "show_date_column": true,
              "show_message_column": true
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 12,
              "height": 5
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 17,
        "width": 12,
        "height": 9,
        "is_column_break": false
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Pods com problema",
        "background_color": "vivid_orange",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "toplist",
              "title": "Restarts por container",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "max:kubernetes.containers.restarts{$env,$service,kube_container_name:(os-service OR cadastro-service OR auto-center-execucao OR autocenter-billing-service)} by {kube_container_name}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      },
                      "conditional_formats": [
                        {
                          "comparator": ">=",
                          "value": 3,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": ">=",
                          "value": 1,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": "<",
                          "value": 1,
                          "palette": "white_on_green"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Ultimo encerramento de container (OOM, erro)",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "max:kubernetes.containers.last_state.terminated{$env,$service,kube_container_name:(os-service OR cadastro-service OR auto-center-execucao OR autocenter-billing-service)} by {kube_container_name,reason}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      },
                      "conditional_formats": [
                        {
                          "comparator": ">=",
                          "value": 1,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": ">=",
                          "value": 1,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": "<",
                          "value": 1,
                          "palette": "white_on_green"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 26,
        "width": 12,
        "height": 4,
        "is_column_break": false
      }
    }
  ]
}
