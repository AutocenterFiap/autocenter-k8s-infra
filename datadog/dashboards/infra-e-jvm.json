{
  "title": "AutoCenter - Infra e JVM",
  "description": "Consumo de CPU e memoria dos pods, JVM dos servicos, Kafka, bancos de dados e no do cluster.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "service",
      "prefix": "service",
      "available_values": [],
      "default": "*"
    }
  ],
  "notify_list": [],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "Containers dos servicos",
        "background_color": "vivid_blue",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "CPU por container (milicores)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:kubernetes.cpu.usage.total{$env,$service,kube_container_name:(os-service OR cadastro-service OR auto-center-execucao OR autocenter-billing-service)} by {kube_container_name}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 / 1000000",
                      "alias": "mCPU"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Memoria por container (% do limite)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:kubernetes.memory.usage{$env,$service,kube_container_name:(os-service OR cadastro-service OR auto-center-execucao OR autocenter-billing-service)} by {kube_container_name}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "avg:kubernetes.memory.limits{$env,$service,kube_container_name:(os-service OR cadastro-service OR auto-center-execucao OR autocenter-billing-service)} by {kube_container_name}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * q1 / q2",
                      "alias": "% memoria"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 90",
                  "display_type": "error dashed",
                  "label": "90%"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Pods em execucao por namespace",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:kubernetes.pods.running{$env,kube_namespace:(autocenter OR auto-center-billing OR auto-center-execucao)} by {kube_namespace}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      }
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Restarts por container",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "max:kubernetes.containers.restarts{$env,$service,kube_container_name:(os-service OR cadastro-service OR auto-center-execucao OR autocenter-billing-service)} by {kube_container_name}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      },
                      "conditional_formats": [
                        {
                          "comparator": ">=",
                          "value": 3,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": ">=",
                          "value": 1,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": "<",
                          "value": 1,
                          "palette": "white_on_green"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 3,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Memoria usada por pod (MB)",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:kubernetes.memory.usage{$env,$service,kube_container_name:(os-service OR cadastro-service OR auto-center-execucao OR autocenter-billing-service)} by {pod_name}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 / 1048576",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      }
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 3,
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 7,
        "is_column_break": false
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "JVM",
        "background_color": "vivid_green",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "note",
              "content": "Metricas enviadas pelo tracer do Datadog (dd-java-agent) via DogStatsD na porta 8125 do agent.",
              "background_color": "gray",
              "font_size": "14",
              "text_align": "left",
              "vertical_align": "center",
              "show_tick": false,
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 1
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Heap usado (% do maximo)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:jvm.heap_memory{$env,$service} by {service}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "avg:jvm.heap_memory_max{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * q1 / q2",
                      "alias": "% heap"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 85",
                  "display_type": "warning dashed",
                  "label": "85%"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 1,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Tempo em GC (ms por minuto)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:jvm.gc.minor_collection_time{$env,$service} by {service}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "sum:jvm.gc.major_collection_time{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "alias": "minor"
                    },
                    {
                      "formula": "q2",
                      "alias": "major"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 1,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Threads",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:jvm.thread_count{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 4,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "CPU do processo Java (%)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:jvm.cpu_load.process{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 * 100"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 4,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Memoria fora do heap (MB)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:jvm.non_heap_memory{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 / 1048576"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 4,
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 12,
        "height": 8,
        "is_column_break": false
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Kafka e bancos de dados",
        "background_color": "vivid_purple",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "CPU (milicores)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:kubernetes.cpu.usage.total{$env,kube_container_name:(kafka OR mysql OR mongodb)} by {kube_namespace,pod_name}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 / 1000000"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Memoria (MB)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:kubernetes.memory.usage{$env,kube_container_name:(kafka OR mysql OR mongodb)} by {kube_namespace,pod_name}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 / 1048576"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Queries por servico",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:trace.mysql.query.hits{$env,$service} by {service}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "sum:trace.mongo.query.hits{$env,$service} by {service}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "alias": "MySQL"
                    },
                    {
                      "formula": "q2",
                      "alias": "Mongo"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Restarts (Kafka e bancos)",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "max:kubernetes.containers.restarts{$env,kube_container_name:(kafka OR mysql OR mongodb)} by {kube_namespace,pod_name}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      },
                      "conditional_formats": [
                        {
                          "comparator": ">=",
                          "value": 3,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": ">=",
                          "value": 1,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": "<",
                          "value": 1,
                          "palette": "white_on_green"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 15,
        "width": 12,
        "height": 7,
        "is_column_break": false
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "No do cluster",
        "background_color": "gray",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "CPU do no (%)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:system.cpu.user{$env} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "avg:system.cpu.system{$env} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 + q2",
                      "alias": "% CPU"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Memoria livre do no (GB)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:system.mem.usable{$env} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 / 1073741824"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Disco usado (%)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "max:system.disk.in_use{$env} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 * 100"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 22,
        "width": 12,
        "height": 4,
        "is_column_break": false
      }
    }
  ]
}
